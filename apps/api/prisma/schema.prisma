generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nickname     String
  avatarUrl    String?
  pairId       String?
  pair         Pair?     @relation(fields: [pairId], references: [id])
  characters   Character[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Pair {
  id        String   @id @default(cuid())
  status    String   @default("active") // active | dissolved
  boundAt   DateTime @default(now())
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id])
  name        String
  personaJson String   @default("{}")
  artKey      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  creatorId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model TruthSession {
  id                String       @id @default(cuid())
  mode              String // solo | duo
  pairId            String?
  creatorId         String
  currentTurnUserId String
  status            String       @default("active") // active | ended
  currentPrompt     String?
  currentLevel      Int          @default(1)
  rounds            TruthRound[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TruthRound {
  id         String       @id @default(cuid())
  sessionId  String
  session    TruthSession @relation(fields: [sessionId], references: [id])
  prompt     String
  level      Int          @default(1)
  answererId String
  answer     String
  createdAt  DateTime     @default(now())
}

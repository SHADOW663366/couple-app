generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nickname     String
  avatarUrl    String?
  pairId       String?
  pair         Pair?     @relation(fields: [pairId], references: [id])
  characters   Character[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Pair {
  id        String   @id @default(cuid())
  status    String   @default("active") // active | dissolved
  boundAt   DateTime @default(now())
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id])
  name        String
  personaJson String   @default("{}")
  artKey      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  creatorId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model TruthSession {
  id                String       @id @default(cuid())
  mode              String // solo | duo
  pairId            String?
  creatorId         String
  currentTurnUserId String
  status            String       @default("active") // active | ended
  currentPrompt     String?
  currentLevel      Int          @default(1)
  rounds            TruthRound[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TruthRound {
  id         String       @id @default(cuid())
  sessionId  String
  session    TruthSession @relation(fields: [sessionId], references: [id])
  prompt     String
  level      Int          @default(1)
  answererId String
  answer     String
  createdAt  DateTime     @default(now())
}

model DiaryEntry {
  id         String       @id @default(cuid())
  authorId   String
  pairId     String?
  visibility String       @default("private") // private | shared | joint
  title      String?
  text       String       @default("")
  media      DiaryMedia[]
  blocks     DiaryBlock[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model DiaryMedia {
  id         String     @id @default(cuid())
  entryId    String
  entry      DiaryEntry @relation(fields: [entryId], references: [id])
  kind       String // image | audio
  url        String // /diary/media/:id
  mime       String?
  durationMs Int?
  size       Int?
  /// 附件二进制入库，避免依赖容器本地 uploads 目录
  data       Bytes?
  createdAt  DateTime   @default(now())
}

model DiaryBlock {
  id        String     @id @default(cuid())
  entryId   String
  entry     DiaryEntry @relation(fields: [entryId], references: [id])
  authorId  String
  text      String     @default("")
  createdAt DateTime   @default(now())
}
